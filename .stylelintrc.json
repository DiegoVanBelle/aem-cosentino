{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["styles/react-tailwind.css"],
  "overrides": [{
    "files": ["react/tailwind.css"],
    "rules": {
      "at-rule-no-unknown": [true, { "ignoreAtRules": ["source", "theme"] }],
      "import-notation": null,
      "at-rule-prelude-no-invalid": [true, { "ignoreAtRules": ["import"] }]
    }
  }]
}
